# ─────────────────────────────────────────────────────────────────────────────
# .env.docker  —  environment for the self-hosted Docker Compose stack
#
# 1. Copy this file:  cp .env.docker.example .env.docker
# 2. Fill in every value that is blank or marked REQUIRED.
# 3. Never commit .env.docker — it is in .gitignore.
#
# See docs/self-hosting.md for step-by-step setup instructions.
# ─────────────────────────────────────────────────────────────────────────────

# ── Convex self-hosted backend ────────────────────────────────────────────────
# The URL external clients (browser, CLI, nginx) use to reach the Convex backend.
# In a single-machine Docker setup this is the HOST machine's IP / domain on port 3210,
# or the nginx public URL if you expose Convex through nginx.
# Example: http://192.168.1.10:3210  or  https://api.yoursite.example
CONVEX_SELF_HOSTED_URL=http://localhost:3210

# Fixed admin key for the Convex backend (prevent key rotation on restart).
# Generate one: openssl rand -hex 32
# REQUIRED unless you want a new key generated on every restart.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ── Frontend (VITE_ vars are embedded into the client JS bundle at build time) ──

# URL of the Convex backend reachable from the browser.
# Same as CONVEX_SELF_HOSTED_URL (in self-hosted mode both URLs are the same).
VITE_CONVEX_URL=http://localhost:3210
VITE_CONVEX_SITE_URL=http://localhost:3210

# onlycrabs.ai soul registry — leave blank to disable
VITE_SOULHUB_SITE_URL=
VITE_SOULHUB_HOST=

# Force site mode: "skills" | "souls" (leave blank for auto-detect by hostname)
VITE_SITE_MODE=

# Git commit SHA shown in the UI drift banner (optional)
VITE_APP_BUILD_SHA=

# ── Runtime server-side vars ──────────────────────────────────────────────────

# Public URL of your web app (used by Convex Auth redirect + CORS)
SITE_URL=http://localhost

# Same as VITE_CONVEX_SITE_URL — also read server-side by the auth provider
CONVEX_SITE_URL=http://localhost:3210

# ── GitHub OAuth App — REQUIRED for user login ───────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:            http://localhost  (or your public domain)
#   Authorization callback:  http://localhost:3210/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── GitLab OAuth App — optional, enables "Sign in with GitLab" ───────────────
# Self-hosted GitLab at gitlab.enflame.cn (or another instance via AUTH_GITLAB_URL).
#
# Create at: https://gitlab.enflame.cn/-/profile/applications
#   Name:          ClawHub
#   Redirect URI:  http://localhost:3210/api/auth/callback/gitlab
#   Scopes:        read_user
#
# Then set these four values:
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=
# Override the GitLab instance URL (defaults to https://gitlab.enflame.cn).
AUTH_GITLAB_URL=https://gitlab.enflame.cn
# VITE_GITLAB_URL is embedded in the browser bundle — set it to show the button.
# Must match AUTH_GITLAB_URL.
VITE_GITLAB_URL=https://gitlab.enflame.cn

# ── Convex Auth JWT signing keys — REQUIRED ───────────────────────────────────
# Generate with:  bunx @convex-dev/auth  (run once against your local Convex)
# Then copy the printed values here.
JWT_PRIVATE_KEY=
JWKS=

# ── OpenAI — optional (vector search degrades to zero-vectors without it) ─────
OPENAI_API_KEY=

# Fine-tune which OpenAI models to use (defaults shown)
# OPENAI_EVAL_MODEL=gpt-5-mini
# OPENAI_CHANGELOG_MODEL=gpt-4.1
# OPENAI_SKILL_SUMMARY_MODEL=gpt-4.1-mini
# OPENAI_COMMENT_EVAL_MODEL=gpt-5-mini

# ── VirusTotal — optional (malware scanning disabled without it) ───────────────
VT_API_KEY=

# ── Discord webhook — optional (notifications disabled without it) ────────────
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_HIGHLIGHTED_ONLY=false

# ── GitHub App — optional (skill/soul backup to GitHub disabled without it) ───
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# Override backup repo targets (defaults shown)
# GITHUB_SKILLS_REPO=clawdbot/skills
# GITHUB_SKILLS_ROOT=skills
# GITHUB_SOULS_REPO=clawdbot/skills
# GITHUB_SOULS_ROOT=souls

# ── GitHub personal token — optional (raises publish gate rate limit) ─────────
GITHUB_TOKEN=

# ── Proxy / IP trust ──────────────────────────────────────────────────────────
# Set to "true" if you are behind a trusted reverse proxy that sets X-Forwarded-For.
# nginx in this docker-compose sets that header, so enable this.
TRUST_FORWARDED_IPS=true
