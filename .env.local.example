# Frontend
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_SOULHUB_SITE_URL=
VITE_SOULHUB_HOST=
VITE_SITE_MODE=
SITE_URL=http://localhost:3000
CONVEX_SITE_URL=

# Convex Auth (GitHub OAuth App)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Convex Auth — GitLab OAuth (self-hosted, optional)
# Set AUTH_GITLAB_ID + AUTH_GITLAB_SECRET to enable GitLab sign-in.
# AUTH_GITLAB_URL defaults to https://gitlab.enflame.cn if not set.
# VITE_GITLAB_URL must also be set so the UI shows the "Sign in with GitLab" button.
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=
AUTH_GITLAB_URL=https://gitlab.enflame.cn
VITE_GITLAB_URL=https://gitlab.enflame.cn

# Convex Auth JWT keys (generated via @convex-dev/auth CLI)
JWT_PRIVATE_KEY=
JWKS=

# Embeddings
OPENAI_API_KEY=
